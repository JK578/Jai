INCIDENTIQ_ENV=development
INCIDENTIQ_READY=true
INCIDENTIQ_STORAGE=auto
# auto uses PostgreSQL when DATABASE_URL is set, otherwise memory. postgres requires a URL.
# Save the real URL only in ignored api.env. Never commit credentials here.
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=require
# Log ingestion uses this same server-only connection. No ingestion runs at startup.
# Resource limits are fixed in code for the single approved 2,000-line artifact.
# Local authentication is enabled by scripts.access_admin bootstrap after reviewed 0004.
# DATABASE_RUNTIME_URL=<restricted login URL with sslmode=verify-full and trusted CA>
INCIDENTIQ_AUTH_ENABLED=false
# INCIDENTIQ_TOKEN_REGISTRY=.cache/access/tokens.json
# Absolute path outside application artifacts; defaults to this checkout's .cache.
# INCIDENTIQ_DATA_DIR=C:/path/to/IncidentIQ/.cache

# Explicit model_probe/investigate OpenAI CLIs only; never API startup.
# Keep the real key in ignored api.env. Model and conservative pricing must be explicit.
# OPENAI_API_KEY=
INCIDENTIQ_MODEL=gpt-5.6-luna
INCIDENTIQ_MODEL_REASONING_EFFORT=none
# Positive integer micro-USD per token, rounded UP from current model pricing.
INCIDENTIQ_MODEL_INPUT_MICROUSD=1
INCIDENTIQ_MODEL_OUTPUT_MICROUSD=2
# Positive integer total micro-USD budget for this CLI invocation / gateway instance.
INCIDENTIQ_MODEL_BUDGET_MICROUSD=20000
# INCIDENTIQ_MODEL_TIMEOUT_SECONDS=20
